@model Projeto_FPAA_Web.Models.Grafo
@{
    ViewData["Title"] = "Lista de Conexões";
}

<div class="card">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Conexões Cadastradas</h4>
    </div>
    <div class="card-body">
        @if (Model.ListaArestas.Count == 0)
        {
            <div class="alert alert-warning" role="alert">
                Nenhuma conexão cadastrada ainda.
            </div>
            <a asp-action="AdicionarAresta" class="btn btn-primary">Adicionar Primeira Conexão</a>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Origem</th>
                            <th>Destino</th>
                            <th>Custo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.ListaArestas.Count; i++)
                        {
                            var aresta = Model.ListaArestas[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>Unidade @(aresta.Origem + 1)</td>
                                <td>Unidade @(aresta.Destino + 1)</td>
                                <td><span class="badge bg-info">@aresta.Peso</span></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3"><strong>Total de Conexões:</strong></td>
                            <td><strong>@Model.ListaArestas.Count</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="mt-3">
                <a asp-action="AdicionarAresta" class="btn btn-primary">Adicionar Mais Conexões</a>
                <a asp-action="ExecutarKruskal" class="btn btn-success">Executar Kruskal</a>
            </div>
        }

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">Voltar ao Início</a>
        </div>
    </div>
</div>
