@model Projeto_FPAA_Web.Models.ResultadoKruskal
@{
    ViewData["Title"] = "Resultado do Algoritmo de Kruskal";
}

<div class="card">
    <div class="card-header @(Model.Sucesso ? "bg-success" : "bg-danger") text-white">
        <h4 class="mb-0">Resultado do Algoritmo de Kruskal</h4>
    </div>
    <div class="card-body">
        @if (Model.Sucesso)
        {
            <div class="alert alert-success" role="alert">
                <h5 class="alert-heading">✓ Sucesso!</h5>
                <p>@Model.Mensagem</p>
            </div>

            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h2 class="display-4 text-success">@Model.CustoTotal</h2>
                            <p class="lead">Custo Total Mínimo</p>
                        </div>
                    </div>
                </div>
            </div>

            <h5>Conexões Escolhidas pela Árvore Geradora Mínima (AGM):</h5>
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead class="table-success">
                        <tr>
                            <th>#</th>
                            <th>Origem</th>
                            <th>Destino</th>
                            <th>Custo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.ArestasEscolhidas.Count; i++)
                        {
                            var aresta = Model.ArestasEscolhidas[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>Unidade @(aresta.Origem + 1)</td>
                                <td>Unidade @(aresta.Destino + 1)</td>
                                <td><span class="badge bg-success">@aresta.Peso</span></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-success">
                            <td colspan="3"><strong>Custo Total:</strong></td>
                            <td><strong>@Model.CustoTotal</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="card mt-3">
                <div class="card-body">
                    <h6>Informações sobre o Resultado:</h6>
                    <ul>
                        <li>Foram selecionadas <strong>@Model.ArestasEscolhidas.Count conexões</strong></li>
                        <li>Estas conexões formam a <strong>Árvore Geradora Mínima (AGM)</strong></li>
                        <li>O custo total é o <strong>menor possível</strong> para conectar todas as unidades</li>
                        <li>O algoritmo de Kruskal garante a solução ótima</li>
                    </ul>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Visualização Gráfica da AGM</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">As arestas em <strong class="text-success">verde</strong> fazem parte da Árvore Geradora Mínima. As em <strong class="text-danger">vermelho tracejado</strong> foram descartadas pelo algoritmo.</p>
                    <div id="kruskalnetwork" style="height: 600px; border: 1px solid #ddd; border-radius: 8px;"></div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-danger" role="alert">
                <h5 class="alert-heading">✗ Erro</h5>
                <p>@Model.Mensagem</p>
            </div>

            @if (Model.Mensagem.Contains("desconexo"))
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <h6>O que significa "grafo desconexo"?</h6>
                        <p>Um grafo é considerado desconexo quando existem unidades que não podem ser alcançadas a partir de outras, ou seja, não há um caminho de conexões que ligue todas as unidades.</p>
                        <p><strong>Solução:</strong> Adicione mais conexões para garantir que todas as unidades estejam interligadas.</p>
                    </div>
                </div>
            }
        }

        <div class="mt-4">
            <a asp-action="Index" class="btn btn-primary">Voltar ao Início</a>
            <a asp-action="AdicionarAresta" class="btn btn-secondary">Adicionar Mais Conexões</a>
            <a asp-action="VisualizarGrafoGrafico" class="btn btn-info">Visualizar Grafo Completo</a>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.Sucesso && ViewBag.Grafo != null)
    {
        var grafo = ViewBag.Grafo as Projeto_FPAA_Web.Models.Grafo;
        
        <script type="text/javascript" src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>
        <script type="text/javascript">
            // Criar os nós (vértices)
            var nodes = new vis.DataSet([
                @for (int i = 0; i < grafo.QuantVertices; i++)
                {
                    @:{ id: @i, label: 'Unidade @(i + 1)', color: '#198754', font: { color: '#ffffff', size: 16, face: 'Arial', bold: true } },
                }
            ]);

            // Criar set com as arestas da AGM para facilitar verificação
            var agmEdges = new Set();
            @foreach (var aresta in Model.ArestasEscolhidas)
            {
                @:agmEdges.add('@aresta.Origem-@aresta.Destino');
                @:agmEdges.add('@aresta.Destino-@aresta.Origem');
            }

            // Criar as arestas com cores diferentes
            var edges = new vis.DataSet([
                @foreach (var aresta in grafo.ListaArestas)
                {
                    var key = $"{aresta.Origem}-{aresta.Destino}";
                    var keyRev = $"{aresta.Destino}-{aresta.Origem}";
                    var isInAGM = Model.ArestasEscolhidas.Any(a => 
                        (a.Origem == aresta.Origem && a.Destino == aresta.Destino) ||
                        (a.Origem == aresta.Destino && a.Destino == aresta.Origem));
                    
                    if (isInAGM)
                    {
                        @:{ from: @aresta.Origem, to: @aresta.Destino, label: '@aresta.Peso', font: { align: 'middle', size: 14, color: '#198754', bold: true }, width: 4, color: { color: '#198754', highlight: '#146c43' } },
                    }
                    else
                    {
                        @:{ from: @aresta.Origem, to: @aresta.Destino, label: '@aresta.Peso', font: { align: 'middle', size: 12, color: '#dc3545' }, width: 1, color: { color: '#dc3545', opacity: 0.5 }, dashes: true },
                    }
                }
            ]);

            // Container
            var container = document.getElementById('kruskalnetwork');

            // Dados
            var data = {
                nodes: nodes,
                edges: edges
            };

            // Opções
            var options = {
                nodes: {
                    shape: 'circle',
                    size: 30,
                    borderWidth: 2,
                    borderWidthSelected: 3,
                    color: {
                        border: '#146c43',
                        background: '#198754',
                        highlight: {
                            border: '#0d5132',
                            background: '#146c43'
                        }
                    }
                },
                edges: {
                    smooth: {
                        type: 'continuous'
                    }
                },
                physics: {
                    enabled: true,
                    stabilization: {
                        enabled: true,
                        iterations: 200
                    },
                    barnesHut: {
                        gravitationalConstant: -2000,
                        centralGravity: 0.3,
                        springLength: 150,
                        springConstant: 0.04
                    }
                },
                interaction: {
                    hover: true,
                    tooltipDelay: 200
                }
            };

            // Criar a rede
            var network = new vis.Network(container, data, options);
        </script>
    }
}
