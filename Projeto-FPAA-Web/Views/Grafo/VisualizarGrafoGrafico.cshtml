@model Projeto_FPAA_Web.Models.Grafo
@{
    ViewData["Title"] = "Visualização Gráfica do Grafo";
}

<div class="card">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Visualização Gráfica do Grafo</h4>
    </div>
    <div class="card-body">
        @if (Model.ListaArestas.Count == 0)
        {
            <div class="alert alert-warning" role="alert">
                Nenhuma conexão cadastrada ainda. Adicione conexões para visualizar o grafo.
            </div>
            <a asp-action="AdicionarAresta" class="btn btn-primary">Adicionar Conexões</a>
        }
        else
        {
            <div class="mb-3">
                <p class="text-muted">Visualização interativa do grafo. Você pode arrastar os nós e usar o scroll para zoom.</p>
            </div>

            <!-- Container para o grafo -->
            <div id="mynetwork" style="height: 600px; border: 1px solid #ddd; border-radius: 8px;"></div>

            <div class="mt-3">
                <h6>Legenda:</h6>
                <ul>
                    <li><span class="badge bg-primary">Círculos azuis</span> = Unidades (vértices)</li>
                    <li><span class="badge bg-secondary">Linhas cinzas</span> = Conexões (arestas)</li>
                    <li>Os números nas linhas representam os custos das conexões</li>
                </ul>
            </div>

            <div class="mt-3">
                <a asp-action="ExecutarKruskal" class="btn btn-success">Executar Kruskal</a>
            </div>
        }

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">Voltar ao Início</a>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.ListaArestas.Count > 0)
    {
        <script type="text/javascript" src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>
        <script type="text/javascript">
            // Criar os nós (vértices)
            var nodes = new vis.DataSet([
                @for (int i = 0; i < Model.QuantVertices; i++)
                {
                    @:{ id: @i, label: 'Unidade @(i + 1)', color: '#0d6efd', font: { color: '#ffffff', size: 16, face: 'Arial', bold: true } },
                }
            ]);

            // Criar as arestas
            var edges = new vis.DataSet([
                @foreach (var aresta in Model.ListaArestas)
                {
                    @:{ from: @aresta.Origem, to: @aresta.Destino, label: '@aresta.Peso', font: { align: 'middle', size: 14 }, width: 2 },
                }
            ]);

            // Container
            var container = document.getElementById('mynetwork');

            // Dados
            var data = {
                nodes: nodes,
                edges: edges
            };

            // Opções
            var options = {
                nodes: {
                    shape: 'circle',
                    size: 30,
                    borderWidth: 2,
                    borderWidthSelected: 3,
                    color: {
                        border: '#0056b3',
                        background: '#0d6efd',
                        highlight: {
                            border: '#004085',
                            background: '#0056b3'
                        }
                    }
                },
                edges: {
                    color: {
                        color: '#6c757d',
                        highlight: '#0d6efd'
                    },
                    smooth: {
                        type: 'continuous'
                    }
                },
                physics: {
                    enabled: true,
                    stabilization: {
                        enabled: true,
                        iterations: 200
                    },
                    barnesHut: {
                        gravitationalConstant: -2000,
                        centralGravity: 0.3,
                        springLength: 150,
                        springConstant: 0.04
                    }
                },
                interaction: {
                    hover: true,
                    tooltipDelay: 200
                }
            };

            // Criar a rede
            var network = new vis.Network(container, data, options);
        </script>
    }
}
